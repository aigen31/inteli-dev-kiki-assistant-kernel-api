# Kernel
KERNEL_PORT=8090
KERNEL_BIND=0.0.0.0:8080
KERNEL_DATABASE_URL=sqlite:///data/kernel.db?mode=rwc
KERNEL_MAX_TOOL_STEPS=4
KERNEL_MAX_MESSAGE_CHARS=8000
KERNEL_MAX_OUTPUT_TOKENS=8000

# Inbound channel tokens. Each BFF uses its own token.
KERNEL_SITE_TOKEN=change-me-site
KERNEL_CRM_TOKEN=change-me-crm

# Public channel route.
KERNEL_CLOUD_BASE_URL=https://api.deepseek.com/v1
KERNEL_CLOUD_API_KEY=
KERNEL_CLOUD_MODEL=deepseek-chat
KERNEL_CLOUD_TIMEOUT_SECONDS=60

# Private channel route. Point this at llama.cpp / LiteLLM.
KERNEL_LOCAL_BASE_URL=http://host.docker.internal:8080/v1
KERNEL_LOCAL_API_KEY=
KERNEL_LOCAL_MODEL=local-model
KERNEL_LOCAL_TIMEOUT_SECONDS=90

# Internal and secret data must not silently go to cloud.
# For a local demo without a local model, set true explicitly. This sends CRM
# data to the cloud; keep false in production.
KERNEL_ALLOW_CLOUD_FOR_INTERNAL=false

# Images in chat. The kernel pulls bytes from the channel provider, checks the
# MIME against image/jpeg|png|webp|gif and keeps them in memory for one call.
KERNEL_MAX_ATTACHMENTS=4
KERNEL_MAX_ATTACHMENT_BYTES=8388608
# Vision is a property of the endpoint. Cloud APIs accept images by default.
# A local llama.cpp needs a multimodal projector (--mmproj) before enabling.
KERNEL_CLOUD_VISION=true
KERNEL_LOCAL_VISION=false

# Domain tool providers. The kernel calls these with the provider token.
KERNEL_SITE_PROVIDER_URL=http://web:8080/internal/assistant
KERNEL_SITE_PROVIDER_TOKEN=change-me-site-provider
KERNEL_CRM_PROVIDER_URL=http://nginx/api/internal/assistant
KERNEL_CRM_PROVIDER_TOKEN=change-me-crm-provider
# Site study: DeepSeek Harness sidecar. Empty URL disables the feature.
KERNEL_HARNESS_URL=http://harness:8090
KERNEL_HARNESS_TOKEN=dev-harness-token
KERNEL_HARNESS_TIMEOUT_SECONDS=300
# Price list snapshot shared by every assistant surface.
KERNEL_PRICING_TTL_SECONDS=900

# CRM MCP server for the harness sidecar (token must match CRM MCP_TOKEN).
CRM_MCP_URL=http://crm-nginx/api/mcp
MCP_TOKEN=change-me-mcp
